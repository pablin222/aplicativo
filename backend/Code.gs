/** Universo IF Avalia. Apps Script V8 vinculado a uma planilha privada. */
const ABAS={projetos:'Projetos',codigos:'Codigos',avaliacoes:'Avaliacoes',config:'Configuracao'};
const HEADERS={Projetos:['id','titulo','modalidade','area_tematica','data','inicio','fim','formato','local','fontes'],Codigos:['hash_codigo','habilitado','criado_em'],Avaliacoes:['id_requisicao','hash_codigo','id_projeto','c1','c2','c3','c4','nota','timestamp','valido'],Configuracao:['chave','valor']};
function db_(){const s=SpreadsheetApp.getActiveSpreadsheet();if(!s)throw Error('PLANILHA_NAO_VINCULADA');return s}
function sheet_(nome){const s=db_().getSheetByName(nome);if(!s)throw Error('ABA_AUSENTE_'+nome);return s}
function rows_(nome){const a=sheet_(nome).getDataRange().getValues();const h=a.shift().map(String);return a.filter(r=>r.some(v=>v!=='' )).map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])))}
function cfg_(){return Object.fromEntries(rows_('Configuracao').map(r=>[r.chave,String(r.valor)]))}
function hash_(token){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,token,Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('')}
function score_(notas){if(!Array.isArray(notas)||notas.length!==4||notas.some(x=>typeof x!=='number'||!Number.isInteger(x)||x<1||x>5))throw Error('NOTAS_INVALIDAS');return Math.round((notas[0]*.3+notas[1]*.3+notas[2]*.25+notas[3]*.15)*100)/100}
function validarToken_(s){return typeof s==='string'&&/^[A-Za-z0-9_-]{24,128}$/.test(s)}
function configurarAbas_(){const ss=db_();Object.entries(HEADERS).forEach(([name,header])=>{let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(s.getLastRow()===0)s.appendRow(header)});const c=sheet_('Configuracao');if(c.getLastRow()===1)[['votacao_aberta','false'],['inicio',''],['fim',''],['minimo_ranking','5'],['catalogo_versao','v1.0']].forEach(r=>c.appendRow(r))}
function importarCatalogo_(){if(typeof CATALOGO_PUBLICO==='undefined')throw Error('CATALOGO_AUSENTE');const p=CATALOGO_PUBLICO;const ids=new Set(p.map(x=>x.id));if(p.length!==46||ids.size!==46||p.filter(x=>/^NAC-\d{3}$/.test(x.id)).length!==24||p.filter(x=>/^EXT-\d{3}$/.test(x.id)).length!==22)throw Error('CATALOGO_INVALIDO');const s=sheet_('Projetos');s.clearContents();s.appendRow(HEADERS.Projetos);p.forEach(x=>s.appendRow([x.id,x.titulo,x.modalidade,x.area_tematica,x.data,x.inicio,x.fim,x.formato,x.local,JSON.stringify(x.fontes)]))}
function cadastrarCodigo_(token){if(!validarToken_(token))throw Error('CODIGO_FORMATO_INVALIDO');const h=hash_(token);if(rows_('Codigos').some(x=>x.hash_codigo===h))throw Error('CODIGO_JA_CADASTRADO');sheet_('Codigos').appendRow([h,true,new Date()]);return 'Código cadastrado'}
function limitarTaxa_(hash){const cache=CacheService.getScriptCache();for(const [key,limite] of [['quota:geral',100],['quota:'+hash,30]]){const total=Number(cache.get(key)||0);if(total>=limite)throw Error('LIMITE_TAXA_TENTE_DEPOIS');cache.put(key,String(total+1),60)}}
function votar_(body){const id=body.id_requisicao,token=body.codigo,projeto=body.id_projeto;if(typeof id!=='string'||!/^[a-zA-Z0-9-]{16,80}$/.test(id)||!validarToken_(token)||typeof projeto!=='string')throw Error('REQUISICAO_INVALIDA');const notas=body.notas,nota=score_(notas);const lock=LockService.getScriptLock();if(!lock.tryLock(20000))throw Error('SERVIDOR_OCUPADO_TENTE_NOVAMENTE');try{const h=hash_(token),votos=rows_('Avaliacoes');const anterior=votos.find(v=>v.id_requisicao===id);if(anterior){if(anterior.hash_codigo!==h||anterior.id_projeto!==projeto||Number(anterior.nota)!==nota||[anterior.c1,anterior.c2,anterior.c3,anterior.c4].some((n,i)=>Number(n)!==notas[i]))throw Error('ID_REQUISICAO_EM_USO');return{ok:true,recibo:{id_requisicao:id,id_projeto:projeto,nota:Number(anterior.nota),registrado_em:String(anterior.timestamp),repeticao:true}}}const c=cfg_(),now=new Date();if(c.votacao_aberta!=='true'||c.inicio&&now<new Date(c.inicio)||c.fim&&now>new Date(c.fim))throw Error('VOTACAO_FECHADA');if(!rows_('Projetos').some(p=>p.id===projeto))throw Error('PROJETO_INEXISTENTE');if(!rows_('Codigos').some(c=>c.hash_codigo===h&&String(c.habilitado).toLowerCase()==='true'))throw Error('CODIGO_INVALIDO');if(votos.some(v=>v.hash_codigo===h&&v.id_projeto===projeto&&String(v.valido).toLowerCase()==='true'))throw Error('VOTO_DUPLICADO');limitarTaxa_(h);sheet_('Avaliacoes').appendRow([id,h,projeto,...notas,nota,now,true]);SpreadsheetApp.flush();const gravado=rows_('Avaliacoes').find(v=>v.id_requisicao===id&&v.hash_codigo===h&&v.id_projeto===projeto);if(!gravado)throw Error('READBACK_FALHOU');CacheService.getScriptCache().removeAll(['ranking:Mostra Nacional','ranking:Mostra de Extensão']);return{ok:true,recibo:{id_requisicao:id,id_projeto:projeto,nota,registrado_em:now.toISOString()}}}finally{lock.releaseLock()}}
function ranking_(modalidade){if(!['Mostra Nacional','Mostra de Extensão'].includes(modalidade))throw Error('MODALIDADE_INVALIDA');const key='ranking:'+modalidade,cache=CacheService.getScriptCache().get(key);if(cache)return JSON.parse(cache);const p=rows_('Projetos').filter(x=>x.modalidade===modalidade),v=rows_('Avaliacoes').filter(x=>String(x.valido).toLowerCase()==='true');const items=p.map(x=>{const a=v.filter(y=>y.id_projeto===x.id),n=a.length;const mean=k=>n?Math.round(a.reduce((s,r)=>s+Number(r[k]),0)/n*100)/100:0;return{id_projeto:x.id,media:mean('nota'),quantidade:n,medias_criterios:['c1','c2','c3','c4'].map(mean),atualizado_em:new Date().toISOString()}});const res={ok:true,items};CacheService.getScriptCache().put(key,JSON.stringify(res),60);return res}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}
function doGet(e){try{if(!e||!e.parameter||!e.parameter.action)return HtmlService.createHtmlOutputFromFile('Index').setTitle('Universo IF Avalia');if(e.parameter.action==='ranking')return json_(ranking_(e.parameter.modalidade));return json_({ok:false,error:'ACAO_INVALIDA'})}catch(err){return json_({ok:false,error:String(err.message)})}}
function doPost(e){try{const b=JSON.parse(e.postData.contents);if(b.action!=='votar')throw Error('ACAO_INVALIDA');return json_(votar_(b))}catch(err){return json_({ok:false,error:String(err.message)})}}
function listarProjetos(){return rows_('Projetos').map(p=>({id:String(p.id),titulo:String(p.titulo),modalidade:String(p.modalidade)}))}
function avaliar(payload){return votar_({...payload})}
function obterRanking(){const titles=Object.fromEntries(rows_('Projetos').map(p=>[p.id,p.titulo]));const min=Math.max(5,Number(cfg_().minimo_ranking)||5);return{ranking:['Mostra Nacional','Mostra de Extensão'].flatMap(modalidade=>{const items=ranking_(modalidade).items;const classificados=items.filter(x=>x.quantidade>=min).sort((a,b)=>b.media-a.media||b.quantidade-a.quantidade||a.id_projeto.localeCompare(b.id_projeto));const pos=Object.fromEntries(classificados.map((x,i)=>[x.id_projeto,i+1]));return items.map(item=>({...item,modalidade,titulo:titles[item.id_projeto]||item.id_projeto,posicao:pos[item.id_projeto]||null}))})}}
function testarDominio_(){if(score_([4,5,4,3])!==4.15)throw Error('FALHA_PESOS');return 'PASS'}
